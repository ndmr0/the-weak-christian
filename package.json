{
  "name": "the-weak-christian",
  "version": "1.0.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "ios": "expo start --ios",
    "android": "expo start --android",
    "web": "expo start --web",
    "create:screenshots": "node scripts/create-app-store-screenshots.mjs",
    "create:handoff": "node scripts/create-review-handoff.mjs",
    "package:public-pages": "node scripts/package-public-pages.mjs",
    "test": "node scripts/validate-data.mjs",
    "check:flow": "node scripts/check-app-flow.mjs",
    "check:today": "node scripts/check-today-layout.mjs",
    "check:review": "node scripts/check-review-assets.mjs",
    "check:store": "node scripts/check-store-readiness.mjs",
    "check:submit": "node scripts/check-submission-readiness.mjs",
    "check:public": "node scripts/check-public-pages.mjs",
    "check:pages-patch": "node scripts/check-pages-patch.mjs",
    "check:eas-ios": "node scripts/check-eas-ios-production-build.mjs",
    "check:local": "node scripts/check-local-readiness.mjs",
    "check:release": "node scripts/check-release-readiness.mjs",
    "check:ios": "expo export --platform ios --dev --output-dir /tmp/twc-check-ios --clear",
    "check:android": "expo export --platform android --dev --output-dir /tmp/twc-check-android --clear",
    "convert:data": "node scripts/convert-data.mjs",
    "validate:data": "node scripts/validate-data.mjs",
    "map:data": "node scripts/apply-note-metadata.mjs .",
    "enrich:data": "node scripts/enrich-data.mjs .",
    "audit:mapping": "node scripts/audit-note-mapping.mjs"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~54.0.35",
    "expo-notifications": "~0.32.17",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-dom": "^19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "babel-preset-expo": "~54.0.10"
  }
}
