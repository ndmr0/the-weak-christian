{
  "expo": {
    "name": "Still",
    "slug": "still",
    "version": "2.0.0",
    "description": "Christ-centered encouragement paired with King James Version Bible verses.",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "still",
    "plugins": [
      [
        "expo-notifications",
        {
          "iosDisplayInForeground": false
        }
      ]
    ],
    "ios": {
      "buildNumber": "2",
      "supportsTablet": false,
      "bundleIdentifier": "com.theweakchristian.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSUserNotificationsUsageDescription": "Optional daily verse reminder."
      }
    },
    "android": {
      "package": "com.theweakchristian.app",
      "versionCode": 2,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F5F5F7"
      }
    },
    "splash": {
      "backgroundColor": "#F5F5F7",
      "resizeMode": "contain"
    }
  }
}
